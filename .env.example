# Fuente de datos: mock | supabase | nexus
CATALOG_SOURCE=mock
ORDERS_SOURCE=mock
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Envíos: estimado | real
SHIPPING_SOURCE=estimado
# Pagos: simulado | mercadopago
PAYMENTS_MODE=simulado
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# Supabase (cuando CATALOG_SOURCE=supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Nexus (solo servidor)
NEXUS_API_URL=
NEXUS_API_KEY=
NEXUS_WEBHOOK_SECRET=
# Analítica (desactivada por defecto)
NEXT_PUBLIC_ANALYTICS_ENABLED=false
